<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd" size="420 240"
        pause="true" lightbox="true">
    <image size="100% 100%" source="structurize:builderhut/builder_paper"/>

    <view pos="10 5" size="400 230">
        <!-- Main header -->
        <view size="100% 15">
            <text size="360 15" text="$(com.ldtteam.structurize.gui.schematicindex.pack_overview.title)" textalign="MIDDLE_LEFT" color="black"/>

            <button id="btn-add" pos="365 0" size="15 15" source="structurize:builderhut/button_plus"/>
            <button id="btn-close" pos="385 0" size="15 15" source="structurize:builderhut/button_x"/>
        </view>

        <!-- Subheader -->
        <view pos="0 20" size="100% 15">
            <input id="pack-search" size="325 15"/>

            <button id="btn-filter-info" pos="330 0" size="15 15" source="structurize:builderhut/button_info"/>
            <button id="btn-filter-warn" pos="350 0" size="15 15" source="structurize:builderhut/button_warn"/>
            <button id="btn-filter-error" pos="370 0" size="15 15" source="structurize:builderhut/button_error"/>
        </view>

        <box pos="0 40" size="100% 1" linewidth="1" color="gray"/>

        <!-- Content -->
        <list id="packs" pos="0 45" size="100% 185" emptytext="$(com.ldtteam.structurize.gui.schematicindex.pack_overview.list_empty)" emptycolor="black">
            <view size="392 23">
                <button id="pack-navigate" pos="5 3" size="15 15" source="structurize:builderhut/button_arrow_right"/>

                <text id="pack-name" pos="25 0" size="235 20" color="black"/>

                <button id="pack-validate" pos="265 3" size="15 15" source="structurize:builderhut/button_validate"/>
                <button id="pack-save" pos="285 3" size="15 15" source="structurize:builderhut/button_save"/>
                <button id="pack-delete" pos="305 3" size="15 15" source="structurize:builderhut/button_delete"/>

                <button id="pack-info-count" pos="330 3" size="15 15" color="black" textalign="MIDDLE" source="structurize:builderhut/builder_button_mini"/>
                <button id="pack-warn-count" pos="350 3" size="15 15" color="black" textalign="MIDDLE" source="structurize:builderhut/builder_button_mini"/>
                <button id="pack-error-count" pos="370 3" size="15 15" color="black" textalign="MIDDLE" source="structurize:builderhut/builder_button_mini"/>
            </view>
        </list>
    </view>
</window>
